"Unsupported format: .%@. Use .mp4, .mov, .html, .metal or a folder with index.html." = "Formato no compatible: .%@. Usa .mp4, .mov, .html, .metal o una carpeta con index.html.";
"The folder has no index.html." = "La carpeta no tiene index.html.";
"Invalid address. It must start with http:// or https://." = "Dirección no válida. Debe empezar con http:// o https://.";
"This Mac has no Metal device available." = "Esta Mac no tiene un dispositivo Metal disponible.";
"Shader source not found." = "No se encontró el código del shader.";
"The shader does not compile:\n%@" = "El shader no compila:\n%@";
"Could not optimize the video: %@" = "No se pudo optimizar el video: %@";
"Enter your Steam API key in Settings → Steam." = "Escribe tu clave de API de Steam en Ajustes → Steam.";
"Steam rejected the API key. Check it in Settings → Steam." = "Steam rechazó la clave de API. Revísala en Ajustes → Steam.";
"Steam responded with HTTP error %lld." = "Steam respondió con el error HTTP %lld.";
"Download failed: %@" = "Falló la descarga: %@";
"The Steam downloader is not installed. Install it in Settings → Steam." = "El descargador de Steam no está instalado. Instálalo en Ajustes → Steam.";
"Sign in with Steam to download. Scan the QR code in Settings → Steam." = "Inicia sesión con Steam para descargar. Escanea el código QR en Ajustes → Steam.";
"Livewall cannot play “%@” wallpapers." = "Livewall no puede reproducir fondos de tipo “%@”.";
"GitHub answered with status %lld." = "GitHub respondió con el estado %lld.";
"The latest release has no Livewall.zip attached." = "La última versión no trae Livewall.zip adjunto.";
"Could not unpack the downloaded update." = "No se pudo descomprimir la actualización descargada.";
