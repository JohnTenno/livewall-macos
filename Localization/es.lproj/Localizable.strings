/* Steam setup: two steps */
"Step 1 · Search the Workshop" = "Paso 1 · Buscar en el Workshop";
"Step 2 · Download wallpapers" = "Paso 2 · Descargar fondos";
"Get a free key" = "Obtener una clave gratis";
"Ready to search" = "Listo para buscar";
"Needed to search the Workshop" = "Necesaria para buscar en el Workshop";
"Steam only uses this key to list wallpapers; it cannot download anything." = "Steam solo usa esta clave para mostrar la lista de fondos; con ella no se puede descargar nada.";
"Downloads use your Steam account, which must own Wallpaper Engine. Scan a QR code with the Steam app once; Livewall never sees your password." = "Las descargas usan tu cuenta de Steam, que debe tener Wallpaper Engine. Escanea un código QR con la app de Steam una sola vez; Livewall nunca ve tu contraseña.";
"First install DepotDownloader (about 80 MB, open source, from GitHub). It downloads Workshop items with your Steam account." = "Primero instala DepotDownloader (unos 80 MB, de código abierto, desde GitHub). Descarga elementos del Workshop con tu cuenta de Steam.";
"Add a Steam API key to search" = "Agrega una clave de API de Steam para buscar";
"Searching the Workshop needs a free Steam Web API key. Downloading is a separate step: signing in with the Steam app." = "Para buscar en el Workshop se necesita una clave gratuita de la API de Steam. Descargar es otro paso aparte: iniciar sesión con la app de Steam.";
"Open Steam settings" = "Abrir ajustes de Steam";
"Downloading needs your Steam account. Sign in by scanning a QR code, then press Download again." = "Para descargar se necesita tu cuenta de Steam. Inicia sesión escaneando un código QR y vuelve a presionar Descargar.";

